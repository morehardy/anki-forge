+const HASH_BUFFER_BYTES: usize = 256 * 1024;
+const MAX_HASH_WORKERS: usize = 4;
+const MIN_PARALLEL_HASH_ENTRIES: usize = 16;
+
+struct MediaHashChunk {
+    bytes: Vec<u8>,
+    last: bool,
+}
+
+fn hash_media_chunks(
+    jobs: std::sync::mpsc::Receiver<MediaHashChunk>,
+    done: std::sync::mpsc::SyncSender<String>,
+) {
+    let mut hash = sha1::Sha1::new();
+    while let Ok(chunk) = jobs.recv() {
+        hash.update(&chunk.bytes);
+        drop(chunk.bytes);
+        if chunk.last {
+            let digest = hex::encode(std::mem::replace(&mut hash, sha1::Sha1::new()).finalize());
+            if done.send(digest).is_err() {
+                break;
+            }
+        }
+    }
