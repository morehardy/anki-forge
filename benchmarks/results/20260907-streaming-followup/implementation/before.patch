+#[test]
+fn deferred_media_hash_has_a_fixed_buffer_and_streams_after_its_boundary() {
+    let mut sink = MediaHash {
+        hash: sha1::Sha1::new(),
+        pending: Some(Vec::with_capacity(HASH_BUFFER_BYTES)),
+    };
+    let bytes: Vec<u8> = (0..HASH_BUFFER_BYTES).map(|i| (i * 31) as u8).collect();
+    // Short writes must not let Vec's geometric growth exceed the bound.
+    for chunk in bytes.chunks(777) {
+        sink.write_all(chunk).unwrap();
+        let pending = sink.pending.as_ref().unwrap();
+        assert!(pending.capacity() <= HASH_BUFFER_BYTES);
+    }
+    assert_eq!(sink.pending.as_deref(), Some(bytes.as_slice()));
+    sink.write_all(b"tail").unwrap();
+    assert!(sink.pending.is_none());
+    let mut expected = sha1::Sha1::new();
+    expected.update(&bytes);
+    expected.update(b"tail");
+    assert_eq!(sink.hash.finalize(), expected.finalize());
+}
