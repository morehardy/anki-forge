+                index,
+                rusqlite::types::Type::Text,
+                Box::new(error),
+            )
+        }),
+        value => Err(rusqlite::Error::InvalidColumnType(
+            index,
+            row.as_ref().column_name(index)?.into(),
+            value.data_type(),
+        )),
+    }
+}
