+            MaskIdentity {
+                ordinal: u16::MAX,
+                active: true,
+            },
+        );
+        identity.media_history.insert(
+            "cafe\u{301}.bin".into(),
+            MediaIdentity {
+                sha1: "a".repeat(40),
+                size: u64::MAX,
