@@ -0,0 +1,43 @@
+
+//! Isolated RSS/speed experiment controls; not a production API.
+use std::{collections::BTreeMap, sync::{Mutex, OnceLock}, time::Instant};
+pub(crate) fn number(name: &str, default: usize) -> usize {
+    std::env::var(format!("ANKIFORGE_RSS_{name}")).ok().map(|s| s.parse().expect("numeric experiment setting")).unwrap_or(default)
+}
+pub(crate) struct Config {
+    pub snapshot_bytes: usize, pub threshold: usize, pub payload_bytes: usize,
+    pub codec: String, pub rows_bytes: usize, pub row_workers: usize,
+    pub render_workers: usize, pub trace: bool,
+}
+pub(crate) fn config() -> &'static Config {
+    static CONFIG: OnceLock<Config> = OnceLock::new();
+    CONFIG.get_or_init(|| Config {
+        snapshot_bytes: number("SNAPSHOT_MIB",4)*1024*1024,
+        threshold: number("THRESHOLD_MIB",1)*1024*1024,
+        payload_bytes: number("PAYLOAD_KIB",4608)*1024,
+        codec: std::env::var("ANKIFORGE_RSS_CODEC").unwrap_or_else(|_|"stream".into()),
+        rows_bytes: number("ROWS_MIB",0)*1024*1024,
+        row_workers: number("ROW_WORKERS",1).clamp(1,4),
+        render_workers: number("RENDER_WORKERS",1).clamp(1,4),
+        trace: number("TRACE",0)!=0,
+    })
+}
+static VALUES: Mutex<BTreeMap<&'static str,u64>> = Mutex::new(BTreeMap::new());
+pub(crate) fn add(key: &'static str, value: u64) {
+    if config().trace { *VALUES.lock().unwrap().entry(key).or_default() += value; }
+}
+pub(crate) struct Span { name: &'static str, start: Option<Instant> }
+impl Span { pub(crate) fn new(name: &'static str) -> Self { Self{name,start:config().trace.then(Instant::now)} } }
+impl Drop for Span { fn drop(&mut self) {if let Some(start)=self.start {add(self.name,start.elapsed().as_nanos() as u64)}} }
+pub(crate) fn observations() -> serde_json::Value { serde_json::to_value(&*VALUES.lock().unwrap()).unwrap() }
+pub(crate) fn ordered<T:Send>(count:usize,workers:usize,f:impl Fn(usize)->T+Sync)->Vec<T> {
+    if workers==1 || count<32 {return (0..count).map(f).collect();}
+    std::thread::scope(|scope| {
+        let chunk=count.div_ceil(workers);
+        let handles=(0..workers).filter_map(|w| {
+            let start=w*chunk; let end=(start+chunk).min(count); let f=&f;
+            (start<end).then(||scope.spawn(move ||(start..end).map(f).collect::<Vec<_>>()))
+        }).collect::<Vec<_>>();
+        handles.into_iter().flat_map(|h|h.join().expect("experiment worker panic")).collect()
+    })
+}
