+pub(crate) fn prepare_experimental_rows(
+    normalized:&NormalizedIr,
+    hash:impl Fn(&NormalizedNote,&NormalizedNotetype,&PreparedRow)->Result<String>+Sync,
+) -> Result<PreparedRows> {
+    let budget=crate::experiment::config().rows_bytes;
+    if budget==0 {return Ok(Default::default());}
+    let _span=crate::experiment::Span::new("prepare_rows_ns");
+    let models=normalized.notetypes.iter().map(|m|(m.id.as_str(),PreparedNotetype::new(m))).collect::<std::collections::BTreeMap<_,_>>();
+    // Include strings, planned cards, keys and map overhead in the retained budget.
+    let mut used=0usize; let mut cache=PreparedRows::new();
+    let workers=crate::experiment::config().row_workers;
+    // Larger batches amortize thread creation but have an independent 8 MiB byte window.
+    let mut first=0;
+    while first<normalized.notes.len() && used<budget {
+        let mut last=first; let mut estimated=0usize;
+        while last<normalized.notes.len() {
+            let n=&normalized.notes[last];
+            let size=n.fields.values().map(String::len).sum::<usize>().saturating_mul(2)+n.tags.iter().map(String::len).sum::<usize>()+1024;
+            if last>first && estimated.saturating_add(size)>8*1024*1024 {break;}
+            estimated=estimated.saturating_add(size);last+=1;
+            if estimated>budget-used {break;}
+        }
+        let results=crate::experiment::ordered(last-first,workers,|offset| -> Result<_> {
+            let n=&normalized.notes[first+offset];let prepared=&models[n.notetype_id.as_str()];
+            let mut stripped=StrippedNoteFields::new(n);
+            let mut row=PreparedRow {storage:note_storage_values(n,prepared,&mut stripped)?,tags:n.tags.join(" "),cards:plan_cards(n,prepared.notetype),content_hash:String::new()};
+            row.content_hash=hash(n,prepared.notetype,&row)?;Ok(row)
+        });
+        for (offset,row) in results.into_iter().enumerate() {
+            let row=row?; let key=&normalized.notes[first+offset].id;
+            let size=row.storage.flds.capacity()+row.storage.sfld.capacity()+row.tags.capacity()+row.cards.capacity()*std::mem::size_of::<super::card_plan::PlannedCard>()+row.content_hash.capacity()+key.len()+256;
+            if used.saturating_add(size)>budget {return Ok(cache);}
+            used+=size;cache.insert(key.clone(),row);
+        }
+        first=last;
+    }
+    crate::experiment::add("retained_rows",cache.len() as u64);
+    crate::experiment::add("retained_row_bytes",used as u64);
+    Ok(cache)
+}
