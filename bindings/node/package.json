{
  "name": "ankiforge",
  "version": "0.3.0",
  "description": "Typed Node.js SDK for stable Anki publications, powered by Rust",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "homepage": "https://ankiforge.dev/",
  "bugs": {
    "url": "https://github.com/morehardy/anki-forge/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morehardy/anki-forge.git",
    "directory": "bindings/node"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist/cjs",
    "dist/index.mjs",
    "dist/index.d.mts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "RELEASING.md",
    "COVERAGE.md"
  ],
  "optionalDependencies": {
    "ankiforge-darwin-arm64": "0.3.0",
    "ankiforge-darwin-x64": "0.3.0",
    "ankiforge-linux-x64-gnu": "0.3.0",
    "ankiforge-win32-x64-msvc": "0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:js": "node scripts/build-js.mjs",
    "check": "node toolchain/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:product": "node scripts/test.mjs",
    "test:parity": "node scripts/test.mjs --parity",
    "test:installed": "node scripts/installed-smoke.mjs",
    "example:minimal": "node scripts/example.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-package.mjs --all",
    "prepare:platforms": "node scripts/platforms.mjs",
    "pack:local": "node scripts/pack.mjs",
    "pack:release": "node scripts/pack.mjs --all",
    "setup": "npm ci --prefix toolchain --ignore-scripts"
  }
}
