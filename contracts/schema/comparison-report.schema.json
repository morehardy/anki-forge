{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Completed native comparison snapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ankiforge-comparison-v1"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "RISK.NOTE_ADDED",
              "RISK.NOTE_CHANGED",
              "RISK.NOTE_REMOVED",
              "RISK.CARD_ADDED",
              "RISK.CARD_REMOVED",
              "RISK.MODEL_ADDED",
              "RISK.MODEL_CHANGED",
              "RISK.MODEL_REMOVED",
              "RISK.SORT_FIELD_CHANGED",
              "RISK.FIELD_ADDED",
              "RISK.FIELD_REMOVED",
              "RISK.TEMPLATE_ADDED",
              "RISK.TEMPLATE_REMOVED",
              "RISK.MASK_ADDED",
              "RISK.MASK_REMOVED",
              "RISK.MEDIA_ADDED",
              "RISK.MEDIA_CHANGED",
              "RISK.MEDIA_REMOVED"
            ]
          },
          "level": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "before": {},
                "after": {}
              },
              "required": [
                "selector",
                "before",
                "after"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "code",
          "level",
          "message",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "highest_risk": {
      "anyOf": [
        {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "allows_publication": {
          "type": "boolean"
        },
        "threshold": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "allowed_codes": {
          "type": "array",
          "items": {
            "enum": [
              "RISK.NOTE_ADDED",
              "RISK.NOTE_CHANGED",
              "RISK.NOTE_REMOVED",
              "RISK.CARD_ADDED",
              "RISK.CARD_REMOVED",
              "RISK.MODEL_ADDED",
              "RISK.MODEL_CHANGED",
              "RISK.MODEL_REMOVED",
              "RISK.SORT_FIELD_CHANGED",
              "RISK.FIELD_ADDED",
              "RISK.FIELD_REMOVED",
              "RISK.TEMPLATE_ADDED",
              "RISK.TEMPLATE_REMOVED",
              "RISK.MASK_ADDED",
              "RISK.MASK_REMOVED",
              "RISK.MEDIA_ADDED",
              "RISK.MEDIA_CHANGED",
              "RISK.MEDIA_REMOVED"
            ]
          }
        },
        "unmatched_allowances": {
          "type": "array",
          "items": {
            "enum": [
              "RISK.NOTE_ADDED",
              "RISK.NOTE_CHANGED",
              "RISK.NOTE_REMOVED",
              "RISK.CARD_ADDED",
              "RISK.CARD_REMOVED",
              "RISK.MODEL_ADDED",
              "RISK.MODEL_CHANGED",
              "RISK.MODEL_REMOVED",
              "RISK.SORT_FIELD_CHANGED",
              "RISK.FIELD_ADDED",
              "RISK.FIELD_REMOVED",
              "RISK.TEMPLATE_ADDED",
              "RISK.TEMPLATE_REMOVED",
              "RISK.MASK_ADDED",
              "RISK.MASK_REMOVED",
              "RISK.MEDIA_ADDED",
              "RISK.MEDIA_CHANGED",
              "RISK.MEDIA_REMOVED"
            ]
          }
        },
        "blocking_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "RISK.NOTE_ADDED",
                  "RISK.NOTE_CHANGED",
                  "RISK.NOTE_REMOVED",
                  "RISK.CARD_ADDED",
                  "RISK.CARD_REMOVED",
                  "RISK.MODEL_ADDED",
                  "RISK.MODEL_CHANGED",
                  "RISK.MODEL_REMOVED",
                  "RISK.SORT_FIELD_CHANGED",
                  "RISK.FIELD_ADDED",
                  "RISK.FIELD_REMOVED",
                  "RISK.TEMPLATE_ADDED",
                  "RISK.TEMPLATE_REMOVED",
                  "RISK.MASK_ADDED",
                  "RISK.MASK_REMOVED",
                  "RISK.MEDIA_ADDED",
                  "RISK.MEDIA_CHANGED",
                  "RISK.MEDIA_REMOVED"
                ]
              },
              "level": {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "message": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "before": {},
                    "after": {}
                  },
                  "required": [
                    "selector",
                    "before",
                    "after"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "code",
              "level",
              "message",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "allows_publication",
        "threshold",
        "allowed_codes",
        "unmatched_allowances",
        "blocking_findings"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "byte_range": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "path",
                  "byte_range"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "help": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "source",
          "help"
        ],
        "additionalProperties": false
      }
    },
    "baseline_counts": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "cards": {
          "type": "integer",
          "minimum": 0
        },
        "media": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "notes",
        "cards",
        "media"
      ],
      "additionalProperties": false
    },
    "candidate_counts": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "cards": {
          "type": "integer",
          "minimum": 0
        },
        "media": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "notes",
        "cards",
        "media"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "findings",
    "highest_risk",
    "policy",
    "diagnostics",
    "baseline_counts",
    "candidate_counts"
  ],
  "additionalProperties": false
}
