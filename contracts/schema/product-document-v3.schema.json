{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anki Forge ProductDocument v3",
  "type": "object",
  "required": ["product_document_version", "document_id", "note_types", "notes"],
  "additionalProperties": false,
  "properties": {
    "product_document_version": {"const": "product-v3"},
    "document_id": {"type": "string", "minLength": 1},
    "default_deck_name": {"type": ["string", "null"]},
    "note_types": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/definitions/stockNoteType"},
          {"$ref": "#/definitions/customNoteType"}
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {"$ref": "#/definitions/note"}
    },
    "media": {
      "type": "array",
      "items": {"$ref": "#/definitions/media"}
    }
  },
  "definitions": {
    "sourcePath": {"type": "string", "minLength": 1},
    "field": {
      "type": "object",
      "required": ["name", "key"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "identity": {"type": "boolean"},
        "sort": {"type": "boolean"},
        "required": {"type": "boolean"},
        "source_path": {"$ref": "#/definitions/sourcePath"}
      }
    },
    "generationRule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "anki_default"}}
        },
        {
          "type": "object",
          "required": ["kind", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["all", "any"]},
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "field"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "cloze"},
            "field": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "required": ["name", "key", "front", "back"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "front": {"type": "string", "minLength": 1},
        "back": {"type": "string", "minLength": 1},
        "browser_front": {"type": "string"},
        "browser_back": {"type": "string"},
        "target_deck": {"type": "string", "minLength": 1},
        "generation_rule": {"$ref": "#/definitions/generationRule"},
        "source_path": {"$ref": "#/definitions/sourcePath"}
      }
    },
    "stockNoteType": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "stock"},
        "id": {"enum": ["basic", "cloze", "image_occlusion"]},
        "name": {"type": ["string", "null"]},
        "fields": {"type": "array", "items": {"$ref": "#/definitions/field"}},
        "templates": {"type": "array", "items": {"$ref": "#/definitions/template"}},
        "css": {"type": ["string", "null"]},
        "source_path": {"$ref": "#/definitions/sourcePath"}
      }
    },
    "customNoteType": {
      "type": "object",
      "required": ["kind", "id", "fields", "templates"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "custom"},
        "id": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "note_type_kind": {"enum": ["normal", "cloze"], "default": "normal"},
        "cloze_field": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/field"}
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/template"}
        },
        "identity": {
          "type": "object",
          "required": ["kind", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "fields"},
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "css": {"type": ["string", "null"]},
        "source_path": {"$ref": "#/definitions/sourcePath"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"note_type_kind": {"const": "cloze"}},
            "required": ["note_type_kind"]
          },
          "then": {
            "required": ["cloze_field"],
            "properties": {"templates": {"maxItems": 1}}
          }
        },
        {
          "if": {
            "properties": {"note_type_kind": {"const": "normal"}},
            "required": ["note_type_kind"]
          },
          "then": {"not": {"required": ["cloze_field"]}}
        }
      ]
    },
    "fieldContent": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["text", "html"]},
            "value": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "media_id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["sound", "image"]},
            "media_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "required": ["kind", "note_type_id", "deck_name", "fields"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["stock", "custom"]},
        "note_type_id": {"type": "string", "minLength": 1},
        "stable_id": {"type": "string", "minLength": 1},
        "deck_name": {"type": "string", "minLength": 1},
        "fields": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/fieldContent"}
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_path": {"$ref": "#/definitions/sourcePath"}
      }
    },
    "media": {
      "type": "object",
      "required": ["id", "source", "export_as"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "export_as": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/definitions/sourcePath"},
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "path"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "file"},
                "path": {"type": "string", "minLength": 1}
              }
            },
            {
              "type": "object",
              "required": ["kind", "source_label", "data_base64"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "inline_base64"},
                "source_label": {"type": "string", "minLength": 1},
                "data_base64": {"type": "string"}
              }
            }
          ]
        }
      }
    }
  }
}
