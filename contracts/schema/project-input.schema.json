{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native tool project input recipe v1",
  "type": "object",
  "properties": {
    "format_version": {
      "const": "ankiforge-project-v1"
    },
    "namespace": {
      "allOf": [
        {
          "$ref": "#/definitions/stableKey"
        },
        {
          "not": {
            "pattern": "[/\\\\]"
          }
        },
        {
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "default_deck": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "custom"
              },
              "key": {
                "$ref": "#/definitions/stableKey"
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "$ref": "#/definitions/fieldKey"
                    },
                    "name": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/fieldKey"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "sort": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "key"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "templates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "$ref": "#/definitions/stableKey"
                    },
                    "name": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "front": {
                      "type": "string"
                    },
                    "back": {
                      "type": "string"
                    },
                    "browser_front": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "browser_back": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "target_deck": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "generation_rule": {
                      "anyOf": [
                        {
                          "oneOf": [
                            {
                              "type": "object",
                              "required": [
                                "kind"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "kind": {
                                  "const": "anki_default"
                                }
                              }
                            },
                            {
                              "type": "object",
                              "required": [
                                "kind",
                                "fields"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "kind": {
                                  "enum": [
                                    "all",
                                    "any"
                                  ]
                                },
                                "fields": {
                                  "type": "array",
                                  "minItems": 1,
                                  "uniqueItems": true,
                                  "items": {
                                    "$ref": "#/definitions/fieldKey"
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "front",
                    "back"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "css": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cloze_field": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/fieldKey"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "assets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "kind",
              "key",
              "fields",
              "templates"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "bundle"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/definitions/stableKey"
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "bytes"
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    }
                  },
                  "mime": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "kind",
                  "data",
                  "mime"
                ],
                "additionalProperties": false
              }
            ]
          },
          "export_as": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/definitions/stableKey"
          },
          "content": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "basic"
                  },
                  "front": {
                    "$ref": "#/definitions/content"
                  },
                  "back": {
                    "$ref": "#/definitions/content"
                  }
                },
                "required": [
                  "kind",
                  "front",
                  "back"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "cloze"
                  },
                  "text": {
                    "$ref": "#/definitions/content"
                  },
                  "back_extra": {
                    "$ref": "#/definitions/content"
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "custom"
                  },
                  "model": {
                    "$ref": "#/definitions/stableKey"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/definitions/content"
                    },
                    "propertyNames": {
                      "$ref": "#/definitions/fieldKey"
                    }
                  }
                },
                "required": [
                  "kind",
                  "model",
                  "fields"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "image_occlusion"
                  },
                  "image": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "masks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "$ref": "#/definitions/stableKey"
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "key",
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "mode": {
                    "enum": [
                      "hide_all_guess_one",
                      "hide_one_guess_one"
                    ]
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/definitions/content"
                    }
                  }
                },
                "required": [
                  "kind",
                  "image",
                  "masks"
                ],
                "additionalProperties": false
              }
            ]
          },
          "deck": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "$comment": "Match Rust char::is_control and char::is_whitespace explicitly; ECMAScript \\s differs for U+0085 and U+FEFF. The afid:: prefix is reserved, case-sensitively.",
              "not": {
                "pattern": "[\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]|^afid::"
              }
            }
          }
        },
        "required": [
          "key",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "namespace",
    "notes"
  ],
  "additionalProperties": false,
  "definitions": {
    "content": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "html"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "image",
                "sound"
              ]
            },
            "asset": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "asset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sequence"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/content"
              }
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stableKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "fieldKey": {
      "allOf": [
        {
          "$ref": "#/definitions/stableKey"
        },
        {
          "not": {
            "pattern": "[{}:#^/!]"
          }
        },
        {
          "not": {
            "enum": [
              "Card",
              "CardFlag",
              "Deck",
              "FrontSide",
              "Subdeck",
              "Tags",
              "Type"
            ]
          }
        }
      ]
    }
  }
}
