{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anki Forge Template Bundle v2",
  "type": "object",
  "required": [
    "format_version",
    "note_type"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "template-bundle-v2"
    },
    "css_file": {
      "anyOf": [
        {
          "$ref": "#/definitions/relativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "export_as"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/definitions/relativePath"
          },
          "export_as": {
            "$ref": "#/definitions/exportFilename"
          }
        }
      }
    },
    "note_type": {
      "type": "object",
      "required": [
        "key",
        "fields",
        "templates"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "$ref": "#/definitions/displayName"
            },
            {
              "type": "null"
            }
          ]
        },
        "cloze_field": {
          "anyOf": [
            {
              "$ref": "#/definitions/fieldKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/field"
          }
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/template"
          }
        },
        "key": {
          "$ref": "#/definitions/stableKey"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "cloze_field"
            ],
            "properties": {
              "cloze_field": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "templates": {
                "maxItems": 1,
                "items": {
                  "properties": {
                    "generation_rule": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "anki_default"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|[\\\\:\\u0000]|(^|/)\\.\\.(/|$))"
      },
      "$comment": "Portable bundle-relative path syntax. File existence, regular-file checks, symlink containment and file byte budgets are verified by the loader."
    },
    "field": {
      "type": "object",
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/definitions/fieldKey"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/definitions/fieldKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort": {
          "type": "boolean",
          "default": false
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "generationRule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "anki_default"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/fieldKey"
              }
            }
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "required": [
        "key",
        "front_file",
        "back_file"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/definitions/stableKey"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/definitions/displayName"
            },
            {
              "type": "null"
            }
          ]
        },
        "front_file": {
          "$ref": "#/definitions/relativePath"
        },
        "back_file": {
          "$ref": "#/definitions/relativePath"
        },
        "browser_front_file": {
          "anyOf": [
            {
              "$ref": "#/definitions/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "browser_back_file": {
          "anyOf": [
            {
              "$ref": "#/definitions/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_deck": {
          "anyOf": [
            {
              "$ref": "#/definitions/deckName"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_rule": {
          "anyOf": [
            {
              "$ref": "#/definitions/generationRule"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stableKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "$comment": "Use Rust whitespace explicitly; ECMAScript \\s differs for U+0085 and U+FEFF."
    },
    "fieldKey": {
      "allOf": [
        {
          "$ref": "#/definitions/stableKey"
        },
        {
          "not": {
            "pattern": "[{}:#^/!]"
          }
        },
        {
          "not": {
            "enum": [
              "Card",
              "CardFlag",
              "Deck",
              "FrontSide",
              "Subdeck",
              "Tags",
              "Type"
            ]
          }
        }
      ]
    },
    "deckName": {
      "type": "string",
      "minLength": 1,
      "$comment": "Match valid_authored_deck_name: nonempty :: components, no boundary whitespace/colons, and no Rust control characters. Single colons and non-control whitespace inside components remain valid.",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]|(^|::)[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000:]|[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000:](::|$)|:::"
      }
    },
    "exportFilename": {
      "$comment": "Portable export filename syntax. maxLength counts Unicode scalar values; the runtime additionally enforces the 255 UTF-8 byte budget.",
      "allOf": [
        {
          "$ref": "#/definitions/stableKey"
        },
        {
          "maxLength": 255,
          "not": {
            "pattern": "[/\\\\<>:\"|?*\\[\\]]|\\.$|^([cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][lL][oO][cC][kK]\\$|([cC][oO][mM]|[lL][pP][tT])[1-9\u00b9\u00b2\u00b3])(\\.|$)"
          }
        }
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "$comment": "Nonblank under Rust str::trim, without control characters; surrounding whitespace is allowed.",
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    }
  }
}
