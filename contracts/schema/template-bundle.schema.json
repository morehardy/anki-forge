{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anki Forge Template Bundle v2",
  "type": "object",
  "required": [
    "format_version",
    "note_type"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "template-bundle-v2"
    },
    "css_file": {
      "anyOf": [
        {
          "$ref": "#/definitions/relativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "export_as"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/definitions/relativePath"
          },
          "export_as": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "note_type": {
      "type": "object",
      "required": [
        "key",
        "fields",
        "templates"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "cloze_field": {
          "anyOf": [
            {
              "$ref": "#/definitions/fieldKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/field"
          }
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/template"
          }
        },
        "key": {
          "$ref": "#/definitions/stableKey"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "cloze_field"
            ],
            "properties": {
              "cloze_field": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "templates": {
                "maxItems": 1,
                "items": {
                  "properties": {
                    "generation_rule": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "anki_default"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|^[A-Za-z]:[\\\\/]|(^|[\\\\/])\\.\\.([\\\\/]|$))"
      }
    },
    "field": {
      "type": "object",
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/definitions/fieldKey"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/definitions/fieldKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort": {
          "type": "boolean",
          "default": false
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "generationRule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "anki_default"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/fieldKey"
              }
            }
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "required": [
        "key",
        "front_file",
        "back_file"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/definitions/stableKey"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "front_file": {
          "$ref": "#/definitions/relativePath"
        },
        "back_file": {
          "$ref": "#/definitions/relativePath"
        },
        "browser_front_file": {
          "anyOf": [
            {
              "$ref": "#/definitions/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "browser_back_file": {
          "anyOf": [
            {
              "$ref": "#/definitions/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_deck": {
          "anyOf": [
            {
              "$ref": "#/definitions/nonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_rule": {
          "anyOf": [
            {
              "$ref": "#/definitions/generationRule"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stableKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "fieldKey": {
      "allOf": [
        {
          "$ref": "#/definitions/stableKey"
        },
        {
          "not": {
            "pattern": "[{}:#^/!]"
          }
        },
        {
          "not": {
            "enum": [
              "Card",
              "CardFlag",
              "Deck",
              "FrontSide",
              "Subdeck",
              "Tags",
              "Type"
            ]
          }
        }
      ]
    }
  }
}
