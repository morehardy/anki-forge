---
import type { CollectionEntry } from 'astro:content';
import { formatDate, sitePath } from '../lib/site';
import { createTranslator } from '../i18n/messages.mjs';
import { pagePath } from '../../site-model.mjs';
import Icon from './Icon.astro';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const locale = post.data.locale;
const t = createTranslator(locale);
---
<article class="post-card">
  <div class="post-meta"><span>{t(`blog.${post.data.category}`)}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time></div>
  <h3><a href={sitePath(pagePath(`blog:${post.data.translationKey}`, locale))}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <a class="text-link" href={sitePath(pagePath(`blog:${post.data.translationKey}`, locale))} aria-label={t('blog.readLabel', { title: post.data.title })}>{t('blog.read')} <Icon name="arrowRight" /></a>
</article>
