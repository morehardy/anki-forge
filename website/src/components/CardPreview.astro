---
import type { CardExample } from '../lib/examples';
import { sitePath } from '../lib/site';
import Icon from './Icon.astro';
interface Props { example: CardExample; prefix: string }
const { example, prefix } = Astro.props;
const { clozeParts: cloze } = example;
---
<div class="card-preview" data-card-preview>
  <div class="preview-label"><span>{example.deck}</span><Icon name="cards" /></div>
  <div class="flashcard" data-flashcard>
    <div class="flashcard-inner">
      <div class="flashcard-face" data-side="front">
        {example.id === 'basic' && <><span class="card-caption">Spanish → English</span><p class="card-word">{example.front}</p><span class="card-caption">What does this mean?</span></>}
        {example.id === 'cloze' && cloze && <><span class="card-caption">Complete the sentence</span><p class="card-sentence">{cloze[1]}<span class="cloze">[…]</span>{cloze[3]}</p></>}
        {example.id === 'media' && <><span class="card-caption">Ear training</span><p class="card-prompt">{example.front}</p><img class="waveform" src={sitePath(`/generated/${example.image}`)} width="320" height="104" alt="Illustrative waveform of a synthesized tone" /></>}
        {example.id === 'occlusion' && <><span class="card-caption">Cell anatomy</span><p class="card-prompt">{example.front}</p><div class="occlusion-diagram"><img src={sitePath(`/generated/${example.image}`)} width={example.imageWidth} height={example.imageHeight} alt="Animal cell cross section with one structure hidden" /><span class="occlusion-cover" style={example.maskStyle} aria-hidden="true">?</span></div></>}
      </div>
      <div class="flashcard-face flashcard-back" data-side="back" aria-hidden="true">
        {example.id === 'basic' && <><span class="card-caption">{example.front}</span><p class="card-answer">{example.back}</p><span class="card-caption">A greeting in Spanish.</span></>}
        {example.id === 'cloze' && cloze && <><span class="card-caption">Complete the sentence</span><p class="card-sentence">{cloze[1]}<span class="cloze">{cloze[2]}</span>{cloze[3]}</p><span class="card-caption">{example.back}</span></>}
        {example.id === 'media' && <><span class="card-caption">A synthesized sine tone</span><p class="card-answer">{example.back}</p><span class="card-caption">One second of concert A.</span></>}
        {example.id === 'occlusion' && <><span class="card-caption">Cell anatomy</span><p class="card-answer">{example.back}</p><div class="occlusion-diagram"><img src={sitePath(`/generated/${example.image}`)} width={example.imageWidth} height={example.imageHeight} alt="Animal cell cross section showing its coral-colored nucleus" /></div></>}
      </div>
    </div>
  </div>
  {example.id === 'media' && <audio controls preload="none" src={sitePath(`/generated/${example.audio}`)} aria-label="Play the example pitch">Your browser does not support audio. <a href={sitePath(`/generated/${example.audio}`)}>Download the tone.</a></audio>}
  <button class="text-button flip-button" type="button" data-flip aria-pressed="false" aria-describedby={`${prefix}-card-status`}><Icon name="arrowsClockwise" /><span>Show answer</span></button>
  <p class="sr-only" id={`${prefix}-card-status`} data-card-status aria-live="polite">Question shown.</p>
  <noscript><p class="no-script-note">Answer: {cloze ? cloze[2] : example.back}</p></noscript>
</div>
