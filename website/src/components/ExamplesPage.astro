---
import { createTranslator } from '../i18n/messages.mjs';
import { pagePath } from '../../site-model.mjs';
import SiteLayout from '../layouts/SiteLayout.astro';
import CardPreview from './CardPreview.astro';
import CodeBlock from './CodeBlock.astro';
import UpdateDemo from './UpdateDemo.astro';
import Icon from './Icon.astro';
import { examples, showcase, updateExample } from '../lib/examples';
import { sitePath } from '../lib/site';
interface Props { locale?: 'en' | 'zh-CN' }
const { locale = 'en' } = Astro.props;
const t = createTranslator(locale);
const href = (id: string, section = '') => sitePath(pagePath(id, locale, section));
---
<SiteLayout locale={locale} title={t('examples.title')} description={t('examples.description')}>
  <div class="container">
    <header class="page-intro"><h1>{t('examples.heading1')}<br />{t('examples.heading2')}</h1><p>{t('examples.intro')}</p><div class="example-intro-actions"><a class="text-link" href={sitePath(`/generated/${showcase.combined.file}`)} download>{t('examples.combined')} <Icon name="arrowRight" /></a><a class="text-link" href={sitePath('/generated/website_showcase.rs')}>{t('examples.fullSource')} <Icon name="arrowUpRight" /></a></div></header>
    <div class="example-list">
      {examples.map(example => <section class="example-detail" id={example.id} aria-labelledby={`${example.id}-heading`}>
        <h2 id={`${example.id}-heading`}>{t(`card.${example.id}`)}</h2>
        <p>{t(`examples.${example.id}`)}</p>
        <div class="example-panel"><div class="example-source"><div class="source-label"><span>{example.id}.rs</span><span>{t('examples.excerpt')}</span></div><CodeBlock locale={locale} code={example.source} /></div><CardPreview locale={locale} example={example} prefix={`gallery-${example.id}`} /></div>
        <div class="example-downloads"><a class="text-link" href={sitePath(`/generated/${example.file}`)} download>{t('examples.download', { file: example.file })} <Icon name="arrowRight" /></a><span>{t('examples.counts', example.counts)}</span></div>
      </section>)}
      <section class="example-detail" id="updates" aria-labelledby="updates-heading">
        <h2 id="updates-heading">{t('examples.updateTitle')}</h2>
        <p>{t('examples.updateDescription')}</p>
        <div class="identity-section"><CodeBlock locale={locale} code={updateExample.source} /><UpdateDemo locale={locale} /></div>
        <div class="example-downloads"><a href={sitePath(`/generated/${updateExample.previous}`)} download>{t('update.v1')}</a><a href={sitePath(`/generated/${updateExample.next}`)} download>{t('update.v2')}</a><a href={href('rust-guide', 'updating-distributed-decks')}>{t('examples.workflow')}</a></div>
        <p class="example-footnote">{t('examples.limitations')}</p>
      </section>
    </div>
  </div>
</SiteLayout>
