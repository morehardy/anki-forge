---
import Icon from './Icon.astro';
import { repository, sitePath } from '../lib/site';
---
<footer class="site-footer container">
  <p>Anki Forge. Open source, built with Rust.</p>
  <nav aria-label="Footer"><a href={sitePath('/blog/')}>Articles</a><a href={sitePath('/rss.xml')}>RSS</a><a href={`${repository}/blob/main/LICENSE`}>MIT license</a><a class="github-link" href={repository} aria-label="GitHub repository" title="GitHub"><Icon name="githubLogo" /></a></nav>
</footer>
