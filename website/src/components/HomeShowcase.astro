---
interface Props { locale?: 'en' | 'zh-CN' }
const { locale = 'en' } = Astro.props;
const chinese = locale === 'zh-CN';
import { examples, showcase } from '../lib/examples';
import { sitePath } from '../lib/site';
import Icon from './Icon.astro';
import '../styles/showcase.css';

const typeIcons: Record<string, 'textAa' | 'bracketsCurly' | 'waveform' | 'scan'> = { basic: 'textAa', cloze: 'bracketsCurly', media: 'waveform', occlusion: 'scan' };
---
<div class="forge-studio" data-forge-studio>
  <div class="forge-stage" role="img" aria-label={chinese ? "基础问答、填空、媒体和图片遮挡卡片翻转后合成一个 APKG 牌组。" : "Basic, Cloze, Media and Image Occlusion cards flip and combine into an APKG deck."}>
    <div class="forge-composition" aria-hidden="true">
      {examples.map((example, index) => (
        <div class:list={['forge-card', `forge-card-${example.id}`, { 'is-first': index === 0 }]} style={`--stack-index:${index};--card-layer:${examples.length - index}`}>
          <div class="forge-card-flipper">
            {[false, true].map(answer => (
              <div class:list={['forge-card-face', { 'forge-card-back': answer }]}>
                <div class="forge-card-label">
                  <span class="forge-card-type"><Icon name={typeIcons[example.id]} />{chinese ? ({ basic: '基础问答', cloze: '填空', media: '媒体', occlusion: '图片遮挡' })[example.id] : example.label}</span>
                  <span>{chinese ? (answer ? '答案' : '问题') : (answer ? 'Back' : 'Front')}</span>
                </div>
                <div class="forge-card-body">
                  {example.id === 'basic' && <><strong class="forge-card-word">{answer ? example.back : example.front}</strong><span class="forge-card-caption">{chinese ? (answer ? '英语' : '西班牙语') : (answer ? 'English' : 'Spanish')}</span></>}
                  {example.clozeParts && <><p class="forge-card-sentence">{example.clozeParts[1]}<mark>{answer ? example.clozeParts[2] : '[...]'}</mark>{example.clozeParts[3]}</p><span class="forge-card-caption">{answer ? example.back : (chinese ? '补全空缺' : 'Fill the gap.')}</span></>}
                  {example.id === 'media' && <><p class:list={['forge-card-prompt', { 'forge-card-answer': answer }]}>{answer ? example.back : example.front}</p><div class="forge-audio-line"><Icon name="speakerHigh" /><img class="forge-wave" src={sitePath(`/generated/${example.image}`)} width="320" height="104" alt="" /></div><span class="forge-card-caption">{chinese ? '图片 + 音频' : 'Image + audio'}</span></>}
                  {example.id === 'occlusion' && <><div class="forge-cell"><img src={sitePath(`/generated/${example.image}`)} width={example.imageWidth} height={example.imageHeight} alt="" />{!answer && <span class="forge-cell-mask" style={example.maskStyle}>?</span>}</div><p class:list={['forge-card-prompt', { 'forge-card-answer': answer }]}>{answer ? example.back : example.front}</p></>}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
      <div class="forge-stack-label"><Icon name="cards" /><span>{chinese ? 'Anki 牌组' : 'Anki deck'}</span></div>
      <div class="forge-box-shadow"></div>
      <div class="forge-box">
        <div class="forge-box-side"></div>
        <div class="forge-box-front">
          <div class="forge-box-label">
            <div class="forge-box-heading"><span>showcase</span><Icon name="check" /></div>
            <strong>.apkg</strong>
            <span class="forge-box-counts">{showcase.combined.counts.cards} {chinese ? '张卡片' : 'cards'} <span>/</span> {showcase.combined.counts.media} {chinese ? '个媒体文件' : 'media'}</span>
          </div>
          <span class="forge-box-seal forge-box-seal-front"></span>
        </div>
        <div class="forge-box-lid"><span class="forge-box-seal forge-box-seal-top"></span></div>
      </div>
    </div>
  </div>
  <p class="forge-caption"><span>{chinese ? '四种卡片，' : 'Four card types. '}<strong>{chinese ? '一个 Anki 牌组。' : 'One Anki deck.'}</strong></span></p>
</div>
<script>
  import { animateShowcase } from '../scripts/showcase';
  const studio = document.querySelector<HTMLElement>('[data-forge-studio]');
  if (studio) animateShowcase(studio);
</script>
