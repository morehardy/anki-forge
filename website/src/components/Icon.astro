---
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import cards from '@phosphor-icons/core/assets/regular/cards.svg?raw';
import copy from '@phosphor-icons/core/assets/regular/copy.svg?raw';
import scan from '@phosphor-icons/core/assets/regular/scan.svg?raw';
import palette from '@phosphor-icons/core/assets/regular/palette.svg?raw';
import arrowsClockwise from '@phosphor-icons/core/assets/regular/arrows-clockwise.svg?raw';
import textAa from '@phosphor-icons/core/assets/regular/text-aa.svg?raw';
import bracketsCurly from '@phosphor-icons/core/assets/regular/brackets-curly.svg?raw';
import waveform from '@phosphor-icons/core/assets/regular/waveform.svg?raw';
import speakerHigh from '@phosphor-icons/core/assets/regular/speaker-high.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
const icons = { arrowRight, arrowUpRight, cards, copy, scan, palette, arrowsClockwise, textAa, bracketsCurly, waveform, speakerHigh, check };
interface Props { name: keyof typeof icons; class?: string }
const { name, class: className = '' } = Astro.props;
---
<span class:list={['icon', className]} aria-hidden="true" set:html={icons[name]} />
<style>
  .icon { display: inline-flex; width: 1.15em; height: 1.15em; flex-shrink: 0; vertical-align: -.15em; }
  .icon :global(svg) { width: 100%; height: 100%; fill: currentColor; }
</style>
