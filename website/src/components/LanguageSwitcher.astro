---
import { pagePair } from '../../scripts/core-pages.mjs';
import { sitePath } from '../lib/site';
const pair = pagePair(Astro.url.pathname, import.meta.env.BASE_URL.replace(/\/$/, '') || '/');
const chinese = Astro.url.pathname.includes('/zh-cn/');
---
{pair && <a class="language-switch" data-language-switch href={sitePath(chinese ? pair.en : pair.zh)} hreflang={chinese ? 'en' : 'zh-CN'} lang={chinese ? 'en' : 'zh-CN'}>{chinese ? 'English' : '简体中文'}</a>}
<style>.language-switch { white-space: nowrap; font-size: 0.875rem; }</style>
