---
import type { CollectionEntry } from 'astro:content';
import { formatDate, sitePath } from '../lib/site';
import Icon from './Icon.astro';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
---
<article class="post-card">
  <div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
  <h3><a href={sitePath(`/blog/${post.id}/`)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <a class="text-link" href={sitePath(`/blog/${post.id}/`)} aria-label={`Read article: ${post.data.title}`}>Read article <Icon name="arrowRight" /></a>
</article>
