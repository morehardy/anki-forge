---
import { createTranslator } from '../i18n/messages.mjs';
import { localeFromPath } from '../../site-model.mjs';
interface Props { locale?: 'en' | 'zh-CN' }
const { locale = localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL) } = Astro.props;
const t = createTranslator(locale);
---
<label class="theme-label"><span class="sr-only">{t('nav.theme')}</span><select data-theme-picker aria-label={t('nav.theme')} disabled><option value="auto">{t('nav.auto')}</option><option value="light">{t('nav.light')}</option><option value="dark">{t('nav.dark')}</option></select></label>
