---
import SiteLayout from './SiteLayout.astro';
import { corePages } from '../../scripts/core-pages.mjs';
import { sitePath } from '../lib/site';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<SiteLayout title={title} description={description} locale="zh-CN">
  <div class="core-guide container">
    <nav aria-label="核心指南">
      {corePages.filter(page => page.id !== 'home').map(page => <a href={sitePath(page.zh)} aria-current={Astro.url.pathname === sitePath(page.zh) ? 'page' : undefined}>{page.title}</a>)}
      <a href={sitePath('/docs/api/')}>API 参考（英文）</a>
    </nav>
    <article>
      <h1>{title}</h1>
      <slot />
    </article>
  </div>
</SiteLayout>
<style is:global>
  .core-guide { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 48px; padding-block: 44px 80px; }
  .core-guide nav { display: flex; flex-direction: column; align-items: start; gap: 16px; font-size: 14px; }
  .core-guide nav a[aria-current] { font-weight: 700; }
  .core-guide article { min-width: 0; max-width: 780px; }
  .core-guide h1 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 30px; line-height: 1.3; }
  .core-guide h2 { font-size: 27px; margin-block: 38px 16px; }
  .core-guide h3 { font-size: 22px; margin-block: 26px 12px; }
  .core-guide p, .core-guide ul, .core-guide ol, .core-guide pre, .core-guide table { margin-block: 16px; }
  .core-guide pre { padding: 18px; overflow-x: auto; background: var(--af-paper); border: 1px solid var(--af-line); border-radius: 7px; }
  .core-guide table { display: block; overflow-x: auto; border-collapse: collapse; }
  .core-guide td, .core-guide th { padding: 10px; border: 1px solid var(--af-line); text-align: start; }
  .core-guide img { height: auto; }
  @media (max-width: 800px) { .core-guide { grid-template-columns: 1fr; gap: 32px; } .core-guide nav { flex-direction: row; flex-wrap: wrap; gap: 12px 20px; } }
</style>
