---
import { pagePair } from '../../scripts/core-pages.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { description as defaultDescription, sitePath } from '../lib/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; publishedAt?: Date; noindex?: boolean; locale?: 'en' | 'zh-CN' }
const { title, description = defaultDescription, article = false, publishedAt, noindex = false, locale = 'en' } = Astro.props;
const pageTitle = title ? `${title} | Anki Forge` : 'Anki Forge | Build Anki decks from code';
const pair = pagePair(Astro.url.pathname, import.meta.env.BASE_URL.replace(/\/$/, '') || '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {pair && <>
      <link rel="alternate" hreflang="en" href={new URL(sitePath(pair.en), Astro.site)} />
      <link rel="alternate" hreflang="zh-CN" href={new URL(sitePath(pair.zh), Astro.site)} />
    </>}
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Anki Forge Blog" href={sitePath('/rss.xml')} />
    <link rel="sitemap" href={sitePath('/sitemap-index.xml')} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Anki Forge" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={new URL(sitePath('/generated/og.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'zh-CN' ? 'Anki Forge：用代码生成 Anki 牌组。西班牙语示例卡片：hola、hello。' : 'Anki Forge. Anki decks, built from code. A Spanish flashcard: hola, hello.'} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <script is:inline>
      (() => {
        let preference = 'auto';
        try { preference = localStorage.getItem('starlight-theme') || 'auto'; } catch {}
        document.documentElement.dataset.theme = preference === 'dark' || (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'zh-CN' ? '跳到正文' : 'Skip to content'}</a>
    <Header locale={locale} />
    <main id="main" data-pagefind-body><slot /></main>
    <Footer locale={locale} />
    <script src="../scripts/site.ts"></script>
    <!-- Cloudflare Web Analytics -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ab8936f615cc40e7a31bb7db4366b73b"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
