---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { description as defaultDescription, sitePath } from '../lib/site';
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; publishedAt?: Date; noindex?: boolean }
const { title, description = defaultDescription, article = false, publishedAt, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | Anki Forge` : 'Anki Forge | Build Anki decks from code';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Anki Forge Blog" href={sitePath('/rss.xml')} />
    <link rel="sitemap" href={sitePath('/sitemap-index.xml')} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Anki Forge" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL(sitePath('/generated/og.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Anki Forge. Anki decks, built from code. A Spanish flashcard: hola, hello." />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <script is:inline>
      (() => {
        let preference = 'auto';
        try { preference = localStorage.getItem('starlight-theme') || 'auto'; } catch {}
        document.documentElement.dataset.theme = preference === 'dark' || (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body><slot /></main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
