---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import PerformanceEvidence from '../components/PerformanceEvidence.astro';
import ExampleWorkbench from '../components/ExampleWorkbench.astro';
import UpdateDemo from '../components/UpdateDemo.astro';
import Icon from '../components/Icon.astro';
import { sitePath } from '../lib/site';
import '../styles/home.css';

---
<SiteLayout description="Build Basic, Cloze, Image Occlusion and custom Anki cards with Rust, TypeScript or Python. Package media, keep note identities stable and review deck updates.">
  <div class="container">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="home-hero-copy">
        <h1 id="hero-title">Turn your data<br /><span>into Anki decks.</span></h1>
        <p>Build Basic, Cloze, Image Occlusion and custom cards with Rust, TypeScript or Python. Package your media, keep note identities stable, and review changes before distributing the next deck.</p>
        <div class="hero-actions"><a class="button" href={sitePath('/docs/languages/')}>Build your first deck <Icon name="arrowRight" /></a><a class="text-link" href={sitePath('/examples/')}>Explore cards <Icon name="arrowRight" /></a></div>
      </div>
      <HomeShowcase />
    </section>
    <section class="home-install" aria-labelledby="install-heading">
      <div><h2 id="install-heading">Choose your language.</h2><p>Export <code>spanish.apkg</code> with the public 0.3.0 package. Normal export needs no Anki installation.</p></div>
      <div class="home-language-grid">
        <article><h3>Rust</h3><pre><code>cargo add ankiforge@0.3.0</code></pre><a class="text-link" href={sitePath('/docs/quickstart/')}>Build with Rust <Icon name="arrowRight" /></a></article>
        <article><h3>Node / TypeScript</h3><pre><code>npm install --include=optional ankiforge@0.3.0</code></pre><a class="text-link" href={sitePath('/docs/node-quickstart/')}>Build with Node <Icon name="arrowRight" /></a></article>
        <article><h3>Python</h3><pre><code>python -m pip install ankiforge==0.3.0</code></pre><a class="text-link" href={sitePath('/docs/python-quickstart/')}>Build with Python <Icon name="arrowRight" /></a></article>
      </div>
    </section>
    <PerformanceEvidence />

    <section class="home-examples" aria-labelledby="examples-heading">
      <div class="home-examples-heading"><h2 id="examples-heading">See the code. Try the card.</h2><p>Switch between runnable Rust examples, flip the previews, and download the decks they produce.</p></div>
      <ExampleWorkbench />
      <div class="home-more-cards"><span>Go further</span><a href={sitePath('/docs/custom-notetypes/')}>Custom templates <Icon name="arrowRight" /></a><a href={sitePath('/docs/image-occlusion/')}>Occlusion modes <Icon name="arrowRight" /></a><a href={sitePath('/docs/media/')}>Media and video <Icon name="arrowRight" /></a></div>
    </section>

    <section class="section identity-section" aria-labelledby="identity-heading" data-reveal>
      <div class="section-copy">
        <h2 id="identity-heading">Let your notes evolve.<br />Keep their identity.</h2>
        <p>Correct a definition or add an example. Stable IDs and a previous build help Anki Forge match existing notes when you export again.</p>
        <a class="text-link" href={sitePath('/docs/updates/')}>Understand deck updates <Icon name="arrowRight" /></a>
      </div>
      <UpdateDemo />
    </section>

    <section class="features" aria-label="More ways to build" data-reveal>
      <div class="feature"><Icon name="scan" /><div><h3>Catch problems before export.</h3><p>Inspect diagnostics for missing fields, media, and template problems. Make validation part of your build.</p><a class="text-link" href={sitePath('/docs/rust-guide/#projects-and-diagnostics')}>Explore validation <Icon name="arrowRight" /></a></div></div>
      <div class="feature"><Icon name="palette" /><div><h3>Your cards. Your templates.</h3><p>Start with Basic and Cloze, or define your own note types. Keep HTML, CSS, and media in reusable template bundles.</p><a class="text-link" href={sitePath('/docs/templates/')}>Explore templates <Icon name="arrowRight" /></a></div></div>
    </section>

  </div>
</SiteLayout>
