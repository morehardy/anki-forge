---
import { getCollection, render } from 'astro:content';
import CoreGuide from '../../../layouts/CoreGuide.astro';
import { translatedDocs } from '../../../../scripts/core-pages.mjs';
export async function getStaticPaths() {
  const entries = await getCollection('coreGuides');
  return translatedDocs.map(page => {
    const entry = entries.find(entry => entry.id === page.name);
    if (!entry) throw new Error(`Missing Chinese guide: ${page.source}`);
    return { params: { id: page.name }, props: { entry } };
  });
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<CoreGuide title={entry.data.title} description={entry.data.description}><Content /></CoreGuide>
